<?xml version="1.0"?>
<model>
  <name>x500_omni_base</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Arthur Groll</name>
    <email>apvgroll@gmail.com</email>
  </author>
  <description>
    Base identica ao x500 (massa, inercia, colisoes, 4 rotores e sensores),
    porem com o visual do corpo substituido pela malha do omnicopter.
    Usada apenas pelos drones inimigos (x500_lidar_3d_enemy) para diferencia-los
    visualmente dos drones amigos sem alterar a fisica.
  </description>
</model>
